# Opcional: YouTube Data API v3 para detección de live más fiable.
# Sin esta clave, se usa el endpoint público /live del canal.
YOUTUBE_API_KEY=

# Channel ID descubierto: Shiva Kriya Yoga - Escuela Valores Divinos
YOUTUBE_CHANNEL_ID=UCs6BtP_OoMkh18UjszWIuqg

# Misma config que el plugin WP «Anchor Episodes Index»
# Site: https://anchor.fm/shaktianandama · shortcode [anchor_episodes] · max 4
ANCHOR_SITE_URL=https://anchor.fm/shaktianandama
